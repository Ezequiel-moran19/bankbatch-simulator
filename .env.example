# Copiar a .env (no versionado) y completar. Nunca subir valores reales.

# Aplicación (usuario con permisos DML; sobre `auditoria` solo SELECT e INSERT)
BANKBATCH_BD_URL=jdbc:sqlserver://localhost:1433;databaseName=bankbatch;encrypt=true;trustServerCertificate=true
BANKBATCH_BD_USUARIO=
BANKBATCH_BD_CLAVE=

# Migraciones Flyway (usuario separado, con permisos DDL)
BANKBATCH_FLYWAY_USUARIO=
BANKBATCH_FLYWAY_CLAVE=

# JWT (clave de firma larga y aleatoria; expiración fija de 15 minutos)
BANKBATCH_JWT_SECRETO=

# Directorio donde se guardan los CSV recibidos (fuera del repositorio)
BANKBATCH_DIRECTORIO_ARCHIVOS=

# Contraseña inicial del administrador de desarrollo (solo para el script de datos iniciales)
BANKBATCH_ADMIN_CLAVE_INICIAL=
