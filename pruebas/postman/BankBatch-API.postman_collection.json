              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));\r\n\r\npm.test(\"Registra creacion, bloqueo, desbloqueo y baja logica\", () => {\r\n    const acciones = pm.response.json().map(evento => evento.accion);\r\n    pm.expect(acciones).to.have.lengthOf(4);\r\n    pm.expect(acciones).to.include.members([\"CREACION\", \"MODIFICACION\", \"BAJA_LOGICA\"]);\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
